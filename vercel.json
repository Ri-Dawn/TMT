{
  "crons": [
    {
      "path": "/api/cron/release-holds",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/angel",
      "destination": "/quick.html"
    },
    {
      "source": "/verdict",
      "destination": "/quick.html"
    },
    {
      "source": "/ask/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/reserve",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/%23reserve-panel",
      "destination": "/reserve",
      "permanent": false
    },
    {
      "source": "/reserve-panel",
      "destination": "/reserve",
      "permanent": false
    }
  ]
}
